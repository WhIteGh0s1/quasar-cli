#!/bin/sh
# Квазар для Linux-серверов: curl -fsSL quasar.ghostlink.online/linux | sudo sh
set -e

case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) echo "Квазар пока не собран для $(uname -m)"; exit 1 ;;
esac
if [ "$(id -u)" != 0 ]; then
  echo "Нужны права root: curl -fsSL quasar.ghostlink.online/linux | sudo sh"
  exit 1
fi
if ! command -v systemctl >/dev/null 2>&1; then
  echo "Нужен systemd: Квазар работает как служба"
  exit 1
fi

url="https://github.com/WhIteGh0s1/quasar-cli/releases/latest/download/quasar-linux-$arch"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

printf '\n  \033[1m◆ QUASAR\033[0m\n\n'
if command -v curl >/dev/null 2>&1; then
  curl -fL --progress-bar -o "$tmp" "$url"
else
  wget -q --show-progress -O "$tmp" "$url"
fi
chmod +x "$tmp"
"$tmp" install

if [ -t 1 ] && [ -r /dev/tty ]; then
  exec /usr/local/bin/quasar </dev/tty
fi
